{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "LabMonitor FastAPI",
			"type": "shell",
			"command": "server\\venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"uvicorn",
				"app.main:app",
				"--app-dir",
				"server",
				"--host",
				"0.0.0.0",
				"--port",
				"8000"
			],
			"isBackground": true
		},
		{
			"label": "LabMonitor Dashboard",
			"type": "shell",
			"command": "node",
			"args": [
				"frontend/node_modules/vite/bin/vite.js",
				"--config",
				"frontend/vite.config.js",
				"--host",
				"127.0.0.1",
				"frontend"
			],
			"isBackground": true
		}
	]
}
