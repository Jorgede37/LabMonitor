# Conexion a SQL Server con autenticacion integrada de Windows.
SQL_SERVER=localhost
SQL_DATABASE=LabMonitor

# Sustituye por una clave aleatoria segura de al menos 32 caracteres.
JWT_SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Produccion: all para que el worker atienda todas las computadoras.
COMPUTADORA_PRUEBA_ID=all
LABMONITOR_IDLE_TIMEOUT_SECONDS=300
LABMONITOR_HEARTBEAT_TIMEOUT_SECONDS=120

# Cambia localhost por la IP/nombre del servidor si los usuarios abren
# el dashboard desde otra computadora.
PASSWORD_RESET_URL=http://localhost:5173/reset-password
LABMONITOR_DASHBOARD_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=15

# Opcional: completa estos valores si se enviaran correos.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=LabMonitor
SMTP_USE_TLS=true
